<Window x:Class="Kikicast.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Kikicast.App"
 Title="Kikicast" Icon="Assets/kikicast.ico" Width="740" Height="520" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource ForegroundBrush}" ShowInTaskbar="False" Topmost="True"
 ShowActivated="False" InputMethod.IsInputMethodEnabled="False" PreviewKeyDown="HandleKey"
 PreviewMouseDown="PaletteMouseDown" Deactivated="HandleDeactivate">
 <Window.Resources><local:ApplicationIconConverter x:Key="ApplicationIconConverter"/><BooleanToVisibilityConverter x:Key="IconVisibilityConverter"/></Window.Resources>
 <Grid>
  <Border Margin="20" CornerRadius="22" Background="Transparent" BorderBrush="#60000000" BorderThickness="2" IsHitTestVisible="False" Visibility="{DynamicResource BackdropVisibility}">
   <Border.Effect><BlurEffect Radius="12" RenderingBias="Performance"/></Border.Effect>
  </Border>
 <Border Margin="20" Background="Transparent" BorderThickness="0" CornerRadius="22" ClipToBounds="True">
  <Grid x:Name="PaletteSurface" SizeChanged="SurfaceSizeChanged">
   <Image x:Name="FrostImage" Stretch="Fill" Opacity="0.88" IsHitTestVisible="False" Visibility="{DynamicResource BackdropVisibility}">
    <Image.Effect><BlurEffect Radius="22" RenderingBias="Performance"/></Image.Effect>
   </Image>
   <Border CornerRadius="22" Background="{DynamicResource GlassSurfaceBrush}" IsHitTestVisible="False"/>
   <Border CornerRadius="22" IsHitTestVisible="False" Background="{DynamicResource GlassHighlightBrush}">
    <Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint=".5,1">
     <GradientStop Color="Black" Offset="0"/><GradientStop Color="Transparent" Offset=".6"/>
    </LinearGradientBrush></Border.OpacityMask>
   </Border>
   <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="8,0,8,16" Height="58">
     <Grid Margin="0,0,0,10">
      <Path Data="M 18,18 L 25,25 M 21,12 A 9,9 0 1 1 3,12 A 9,9 0 1 1 21,12" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
      <TextBox x:Name="Query" FontSize="23" Padding="0" Margin="38,0,0,0" VerticalContentAlignment="Center" VerticalAlignment="Center"
       Foreground="{DynamicResource ForegroundBrush}" Background="Transparent" BorderThickness="0"
       InputMethod.IsInputMethodEnabled="False" CaretBrush="{DynamicResource AccentBrush}"
       AutomationProperties.Name="Search apps, pinyin or calculations" TextChanged="QueryChanged" LostKeyboardFocus="QueryLostFocus">
       <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost"/></ControlTemplate></TextBox.Template>
      </TextBox>
      <TextBlock x:Name="SearchHint" Text="Search apps and commands…" FontSize="23" Margin="38,0,0,0"
       VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"/>
     </Grid>
     <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BorderBrush}"/>
    </Grid>
    <UniformGrid x:Name="ArgumentStrip" Grid.Row="1" Columns="3" Visibility="Collapsed" Margin="8,0,8,12">
     <StackPanel x:Name="ArgumentSlot1" Margin="0,0,8,0"><TextBlock x:Name="ArgumentLabel1" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBox x:Name="ArgumentValue1" MaxLength="2048" InputMethod.IsInputMethodEnabled="False" AutomationProperties.Name="Command argument 1"/></StackPanel>
     <StackPanel x:Name="ArgumentSlot2" Margin="0,0,8,0"><TextBlock x:Name="ArgumentLabel2" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBox x:Name="ArgumentValue2" MaxLength="2048" InputMethod.IsInputMethodEnabled="False" AutomationProperties.Name="Command argument 2"/></StackPanel>
     <StackPanel x:Name="ArgumentSlot3"><TextBlock x:Name="ArgumentLabel3" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBox x:Name="ArgumentValue3" MaxLength="2048" InputMethod.IsInputMethodEnabled="False" AutomationProperties.Name="Command argument 3"/></StackPanel>
    </UniformGrid>
    <ListBox x:Name="Results" Grid.Row="2" SelectionChanged="ArgumentSelectionChanged" Background="Transparent" Foreground="{DynamicResource ForegroundBrush}" BorderThickness="0"
     ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
     MouseDoubleClick="ActivateSelection" Focusable="False" IsTabStop="False" AutomationProperties.Name="Search results"
     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
     <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
      <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="12,10,0,5" Focusable="False"/>
     </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
      <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
       <Border x:Name="Row" CornerRadius="12" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
        <ContentPresenter/>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource GlassHighlightBrush}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource PaletteSelectionBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="Transparent"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
     </Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Subtitle}">
      <StackPanel x:Name="CurrencyCard" Visibility="Collapsed" Margin="8,12">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding CurrencyInput}" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="→" Foreground="{DynamicResource MutedBrush}" FontSize="24" Margin="16,0" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding CurrencyOutput}" FontSize="25" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Grid>
       <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
      </StackPanel>
      <StackPanel x:Name="NormalRow">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Width="26" Height="26" Margin="0,0,10,0" CornerRadius="6" Background="{DynamicResource GlassHighlightBrush}">
        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="{Binding IconsEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Converter={StaticResource IconVisibilityConverter}}"/>
         <Style.Triggers><DataTrigger Binding="{Binding Entry}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style></Border.Style>
        <Grid><Grid.DataContext><MultiBinding Converter="{StaticResource ApplicationIconConverter}"><Binding Path="Entry"/><Binding Path="IconsEnabled" RelativeSource="{RelativeSource AncestorType={x:Type local:MainWindow}}"/></MultiBinding></Grid.DataContext>
         <TextBlock Text="▦" Foreground="{DynamicResource MutedBrush}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasImage}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
         </TextBlock><Image Source="{Binding Image}" Width="24" Height="24" Stretch="Uniform"/>
        </Grid>
       </Border>
       <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" FontSize="17" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="2" Text="{Binding RightLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
      </Grid>
      <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0">
       <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
        <DataTrigger Binding="{Binding ShowSubtitle}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
       </Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </StackPanel>
     </Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding IsCurrency}" Value="True">
      <Setter TargetName="NormalRow" Property="Visibility" Value="Collapsed"/><Setter TargetName="CurrencyCard" Property="Visibility" Value="Visible"/>
     </DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="3" Margin="8,14,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="Status" Foreground="{DynamicResource MutedBrush}" Text="Double Ctrl" FontSize="11" TextTrimming="CharacterEllipsis"/>
     <TextBlock Grid.Column="1" Foreground="{DynamicResource MutedBrush}" Text="EN   ↑↓ Select   ↵ Run   Ctrl+K Actions" FontSize="11" Margin="12,0,0,0"/>
    </Grid>
   </Grid>
   <Border x:Name="ActionPanel" Visibility="Collapsed" Panel.ZIndex="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="340" MaxHeight="365" Margin="24,24,24,60" Padding="14" CornerRadius="16" Background="{DynamicResource WindowBrush}" BorderThickness="0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="ActionTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="4,0,4,10"/>
     <TextBox x:Name="ActionFilter" Grid.Row="1" FontSize="14" Margin="0,0,0,8" AutomationProperties.Name="Filter actions" InputMethod.IsInputMethodEnabled="False" TextChanged="ActionFilterChanged"/>
     <ListBox x:Name="ActionList" Grid.Row="2" Focusable="False" IsTabStop="False" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ForegroundBrush}" ScrollViewer.VerticalScrollBarVisibility="Hidden" MouseDoubleClick="ActionDoubleClick" AutomationProperties.Name="Actions">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ActionSurface" Padding="8,9" CornerRadius="8" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ActionSurface" Property="Background" Value="{DynamicResource PaletteSelectionBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      </Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13"/><TextBlock Grid.Column="1" Text="{Binding Hint}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </Border>
  </Grid>
 </Border>
 </Grid>
</Window>
